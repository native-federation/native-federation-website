---
import { getCollection, render } from 'astro:content';
import DocPage from '../../layouts/DocPage.astro';
import { DEFAULT_VERSION, VERSION_ROOT, isVersion } from '../../data/nav';

export async function getStaticPaths() {
	const docs = await getCollection('docs');
	const ids = new Set(docs.map((entry) => entry.id));

	return docs.map((entry) => {
		// Every doc lives under a version directory, so entry.id is `<version>/<bareId>`.
		const slash = entry.id.indexOf('/');
		const version = entry.id.slice(0, slash);
		const bareId = entry.id.slice(slash + 1);
		const other = version === 'v4' ? 'v3' : 'v4';
		// Land on the same page in the other tree when it exists there; the version root is
		// the fallback for pages that are exclusive to one version.
		const counterpart = ids.has(`${other}/${bareId}`) ? `${other}/${bareId}` : `${other}/${VERSION_ROOT}`;

		return {
			params: { slug: entry.id },
			props: { entry, version, bareId, otherUrl: `/docs/${counterpart}/` },
		};
	});
}

const { entry, version, bareId, otherUrl } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const SITE = 'https://native-federation.com';
const OG_IMAGE = `${SITE}/images/sujet-dark.jpg`;

// Title: explicit frontmatter title, else the first H1 (matches extractTitle()).
const h1 = headings.find((h) => h.depth === 1)?.text ?? '';
const title = entry.data.title ?? h1;
// Description parity with the old build's `fm.description || extractLead()`: the
// remark-doc-lead plugin sets frontmatter.description from the first blockquote (unless
// already set), surfaced here via remarkPluginFrontmatter; fall back to the title.
const description = remarkPluginFrontmatter?.description ?? entry.data.description ?? title;

// Clean URL /docs/<version>/<id>/ — the glob loader already strips `/index`, matching the old
// build's cleanPath. `directory` build format emits <path>/index.html.
const canonical = `${SITE}/docs/${entry.id}/`;
// alternate text/markdown link -> original source path (e.g. v4/adapters/esbuild/index.md).
const relMd = entry.filePath.replace(/^src\/content\/docs\//, '');
const mdUrl = `${SITE}/docs/${relMd}`;
---

<DocPage
	title={title}
	description={description}
	canonical={canonical}
	mdUrl={mdUrl}
	ogImage={OG_IMAGE}
	version={isVersion(version) ? version : DEFAULT_VERSION}
	activeDoc={bareId}
	otherUrl={otherUrl}
	headings={headings}
>
	<Content />
</DocPage>
